{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src",
    // Los specs E2E también se type-chequean: antes quedaban fuera y un
    // error de tipos en un spec solo aparecía (o no) al correr Playwright.
    // playwright.config.ts queda fuera a propósito: usa `process.env` y el
    // proyecto no tiene @types/node.
    "e2e"
  ],
  // src/video (las 132 compositions de Remotion) se type-chequea aparte:
  // tsconfig.remotion.json / `pnpm typecheck:video`, corriendo en la CI sin
  // bloquear. Así un error de tipos en un video no tumba el build de la app
  // (nada de src/ importa de src/video, la exclusión es limpia).
  "exclude": ["node_modules", "src/video"]
}
